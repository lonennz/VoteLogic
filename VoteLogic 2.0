<!DOCTYPE html>
<html lang="pt-br">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>VoteLogic - Urna Eletrônica Inteligente</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:linear-gradient(135deg,#020617,#0f172a,#111827);
    font-family:Arial, Helvetica, sans-serif;
    color:#e2e8f0;
    min-height:100vh;
    padding:30px;
}

.container{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    align-items:flex-start;
    gap:30px;
}

.urna{
    width:380px;
    background:#111827;
    border:1px solid #1e293b;
    border-radius:20px;
    padding:25px;
    box-shadow:0 0 25px rgba(0,0,0,0.5);
}

.urna h1{
    text-align:center;
    margin-bottom:20px;
    color:#93c5fd;
}

.tela{
    background:#cbd5e1;
    color:#0f172a;
    min-height:240px;
    border-radius:15px;
    padding:20px;
    margin-bottom:20px;
}

.tela h2{
    text-align:center;
}

.numero{
    font-size:42px;
    letter-spacing:12px;
    margin:25px auto;
    background:white;
    width:170px;
    text-align:center;
    padding:12px;
    border-radius:10px;
    border:2px solid #64748b;
    font-weight:bold;
}

.candidatoInfo{
    margin-top:20px;
    font-size:22px;
    text-align:center;
    font-weight:bold;
}

.listaCandidatos{
    background:#0f172a;
    border:1px solid #1e293b;
    border-radius:15px;
    padding:18px;
    margin-bottom:25px;
}

.listaCandidatos h3{
    text-align:center;
    margin-bottom:15px;
    color:#93c5fd;
}

.candidatoCard{
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:#1e293b;
    padding:12px 15px;
    border-radius:10px;
    margin-bottom:10px;
}

.numeroCand{
    background:#2563eb;
    color:white;
    padding:6px 12px;
    border-radius:8px;
    font-weight:bold;
    min-width:55px;
    text-align:center;
}

.teclado{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:12px;
}

.tecla{
    padding:18px;
    background:#1e293b;
    text-align:center;
    border-radius:12px;
    cursor:pointer;
    font-size:24px;
    font-weight:bold;
    border:1px solid #334155;
}

.tecla:hover{
    background:#334155;
}

.confirma{
    background:#065f46;
}

.corrige{
    background:#92400e;
}

.branco{
    background:#e2e8f0;
    color:#0f172a;
}

.resultado{
    flex:1;
    min-width:450px;
    background:#111827;
    border:1px solid #1e293b;
    border-radius:20px;
    padding:30px;
}

.resultado h1{
    text-align:center;
    margin-bottom:25px;
    color:#93c5fd;
}

.tabs{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:12px;
    margin-bottom:25px;
}

.tab-btn{
    background:#1e293b;
    border:1px solid #334155;
    color:#e2e8f0;
    padding:12px 22px;
    border-radius:12px;
    cursor:pointer;
    font-weight:bold;
}

.tab-btn.active{
    background:#2563eb;
}

.tab-content{
    display:none;
}

.tab-content.active{
    display:block;
}

.box{
    background:#0f172a;
    border:1px solid #1e293b;
    padding:20px;
    border-radius:16px;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:20px;
}

th,td{
    border:1px solid #334155;
    padding:14px;
    text-align:center;
}

th{
    background:#1e293b;
    color:#93c5fd;
}

td{
    background:#0f172a;
}

.ativo{
    background:#2563eb !important;
    color:white;
    font-weight:bold;
}

#simplificada{
    color:#38bdf8;
    font-size:22px;
    font-weight:bold;
}

</style>

</head>

<body>

<div class="container">

<div class="urna">

<h1>🗳 VoteLogic</h1>

<div class="tela">

<h2>SEU VOTO PARA</h2>

<div class="numero" id="numeroDigitado">
__
</div>

<div class="candidatoInfo" id="candidatoInfo">
Digite o número do candidato
</div>

</div>

<div class="listaCandidatos">

<h3>📋 Candidatos</h3>

<div class="candidatoCard">
    <span class="numeroCand">10</span>
    <span>👨 João</span>
</div>

<div class="candidatoCard">
    <span class="numeroCand">20</span>
    <span>👩 Maria</span>
</div>

<div class="candidatoCard">
    <span class="numeroCand">30</span>
    <span>👨 Carlos</span>
</div>

<div class="candidatoCard">
    <span class="numeroCand">40</span>
    <span>👩 Ana</span>
</div>

<div class="candidatoCard">
    <span class="numeroCand">50</span>
    <span>👨 Pedro</span>
</div>

</div>

<div class="teclado">

<div class="tecla" onclick="digitar('1')">1</div>
<div class="tecla" onclick="digitar('2')">2</div>
<div class="tecla" onclick="digitar('3')">3</div>

<div class="tecla" onclick="digitar('4')">4</div>
<div class="tecla" onclick="digitar('5')">5</div>
<div class="tecla" onclick="digitar('6')">6</div>

<div class="tecla" onclick="digitar('7')">7</div>
<div class="tecla" onclick="digitar('8')">8</div>
<div class="tecla" onclick="digitar('9')">9</div>

<div class="tecla branco" onclick="branco()">
Branco
</div>

<div class="tecla" onclick="digitar('0')">0</div>

<div class="tecla corrige" onclick="corrigir()">
Corrige
</div>

<div class="tecla confirma" onclick="confirmar()">
Confirma
</div>

</div>

</div>

<div class="resultado">

<h1>📊 Resultado Lógico</h1>

<div class="tabs">

<button class="tab-btn active"
onclick="abrirTab('eleicao', this)">
Eleição
</button>

<button class="tab-btn"
onclick="abrirTab('logica', this)">
Lógica Booleana
</button>

<button class="tab-btn"
onclick="abrirTab('tabela', this)">
Tabela Verdade
</button>

</div>

<div class="tab-content active" id="eleicao">

<div class="box">

<h2>Resultado da Eleição</h2>

<p id="votos">
João: 0 votos<br>
Maria: 0 votos<br>
Carlos: 0 votos<br>
Ana: 0 votos<br>
Pedro: 0 votos
</p>

<h3 id="vencedor">
🏆 Vencedor: Nenhum
</h3>

</div>

</div>

<div class="tab-content" id="logica">

<div class="box">

<h2>Mintermos</h2>
<p id="mintermos">Σ()</p>

<h2>Expressão Simplificada</h2>
<p id="simplificada"></p>

</div>

</div>

<div class="tab-content" id="tabela">

<div class="box">

<h2>Tabela Verdade (5 Variáveis)</h2>

<div id="tabelaConteudo"></div>

</div>

</div>

</div>

</div>

<script>

let numero = '';

let votos = {
    joao:0,
    maria:0,
    carlos:0,
    ana:0,
    pedro:0
};

let mintermos = [];

function abrirTab(id, botao){

    let tabs =
    document.querySelectorAll('.tab-content');

    tabs.forEach(tab=>{
        tab.classList.remove('active');
    });

    document
    .getElementById(id)
    .classList.add('active');

    let botoes =
    document.querySelectorAll('.tab-btn');

    botoes.forEach(btn=>{
        btn.classList.remove('active');
    });

    botao.classList.add('active');
}

function digitar(valor){

    if(numero.length < 2){

        numero += valor;

        atualizarTela();
    }
}

function atualizarTela(){

    document.getElementById("numeroDigitado")
    .innerHTML = numero;

    let info =
    document.getElementById("candidatoInfo");

    if(numero == '10'){
        info.innerHTML = '👨 João';
    }

    else if(numero == '20'){
        info.innerHTML = '👩 Maria';
    }

    else if(numero == '30'){
        info.innerHTML = '👨 Carlos';
    }

    else if(numero == '40'){
        info.innerHTML = '👩 Ana';
    }

    else if(numero == '50'){
        info.innerHTML = '👨 Pedro';
    }

    else{
        info.innerHTML =
        '❌ Candidato não encontrado';
    }
}

function corrigir(){

    numero = '';

    document.getElementById("numeroDigitado")
    .innerHTML = '__';

    document.getElementById("candidatoInfo")
    .innerHTML =
    'Digite o número do candidato';
}

function branco(){

    alert('Voto em branco registrado');

    corrigir();
}

function confirmar(){

    if(numero == '10'){

        votos.joao++;
        adicionarMintermo(1);
    }

    else if(numero == '20'){

        votos.maria++;
        adicionarMintermo(3);
    }

    else if(numero == '30'){

        votos.carlos++;
        adicionarMintermo(7);
    }

    else if(numero == '40'){

        votos.ana++;
        adicionarMintermo(15);
    }

    else if(numero == '50'){

        votos.pedro++;
        adicionarMintermo(17);
    }

    else{

        alert('Número inválido');
        return;
    }

    atualizarVotos();

    gerarResultados();

    corrigir();
}

function adicionarMintermo(valor){

    if(!mintermos.includes(valor)){

        mintermos.push(valor);

        mintermos.sort((a,b)=>a-b);
    }
}

function atualizarVotos(){

    document.getElementById("votos")
    .innerHTML = `

    João: ${votos.joao} votos<br>
    Maria: ${votos.maria} votos<br>
    Carlos: ${votos.carlos} votos<br>
    Ana: ${votos.ana} votos<br>
    Pedro: ${votos.pedro} votos

    `;

    let maior = Math.max(
        votos.joao,
        votos.maria,
        votos.carlos,
        votos.ana,
        votos.pedro
    );

    let vencedor = 'Nenhum';

    if(maior == votos.joao && maior > 0){
        vencedor = 'João';
    }

    if(maior == votos.maria && maior > 0){
        vencedor = 'Maria';
    }

    if(maior == votos.carlos && maior > 0){
        vencedor = 'Carlos';
    }

    if(maior == votos.ana && maior > 0){
        vencedor = 'Ana';
    }

    if(maior == votos.pedro && maior > 0){
        vencedor = 'Pedro';
    }

    document.getElementById("vencedor")
    .innerHTML =
    '🏆 Vencedor: ' + vencedor;
}

function gerarResultados(){

    document.getElementById("mintermos")
    .innerHTML =
    'Σ(' + mintermos.join(', ') + ')';

    document.getElementById("simplificada")
    .innerHTML =
    'F = Σ(' + mintermos.join(', ') + ')';

    gerarTabela();
}

function gerarTabela(){

    let html = '<table>';

    html += `
    <tr>
        <th>A</th>
        <th>B</th>
        <th>C</th>
        <th>D</th>
        <th>E</th>
        <th>F</th>
    </tr>
    `;

    for(let i=0;i<32;i++){

        let b =
        i.toString(2).padStart(5,'0');

        html += '<tr>';

        html += `<td>${b[0]}</td>`;
        html += `<td>${b[1]}</td>`;
        html += `<td>${b[2]}</td>`;
        html += `<td>${b[3]}</td>`;
        html += `<td>${b[4]}</td>`;

        html += `
        <td>
        ${mintermos.includes(i)?1:0}
        </td>
        `;

        html += '</tr>';
    }

    html += '</table>';

    document.getElementById("tabelaConteudo")
    .innerHTML = html;
}

</script>

</body>
</html>